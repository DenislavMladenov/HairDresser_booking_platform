# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# Generate secrets with: openssl rand -base64 48
# ---------------------------------------------------------------------------

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
# Port the NestJS API listens on (inside its container in production).
API_PORT=3000
LOG_LEVEL=log

# --- Database ------------------------------------------------------------
# Used by the postgres container.
POSTGRES_USER=booking
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=booking
# Host port the development database is published on. 5433 avoids clashing with
# any PostgreSQL already installed on the host.
POSTGRES_PORT=5433

# Connection string used by Prisma.
# Development (database in Docker, API on the host):
DATABASE_URL=postgresql://booking:change-me-local-only@localhost:5433/booking?schema=public
# Production (API in Docker, same compose network): host is the service name.
# DATABASE_URL=postgresql://booking:STRONG_PASSWORD@postgres:5432/booking?schema=public

# Separate database used by the integration test suite.
TEST_DATABASE_URL=postgresql://booking:change-me-local-only@localhost:5433/booking_test?schema=public

# --- Application ---------------------------------------------------------
# Public base URL of the application. Used for cookie flags, CORS and the
# Origin check on state-changing requests.
APP_URL=http://localhost:5173
# Extra allowed browser origins, comma separated. Leave empty in production
# when the SPA is served from the same origin as the API.
CORS_ORIGINS=http://localhost:5173

# Business timezone. All working hours are interpreted in this zone.
BUSINESS_TIMEZONE=Europe/Sofia
CURRENCY=BGN

# --- Sessions ------------------------------------------------------------
# Secret used to sign the session cookie. REQUIRED, minimum 32 characters.
SESSION_SECRET=replace-with-openssl-rand-base64-48-output
SESSION_COOKIE_NAME=barber_session
# Absolute session lifetime in days.
SESSION_TTL_DAYS=7

# --- API documentation ---------------------------------------------------
# Swagger is served at /api/docs. Keep it disabled in production unless needed.
ENABLE_SWAGGER=true

# --- Reverse proxy -------------------------------------------------------
# Set to true when the API runs behind Caddy so client IPs (used for rate
# limiting) are read from X-Forwarded-For.
TRUST_PROXY=false

# --- Production / Caddy --------------------------------------------------
# The address Caddy serves. A bare hostname gets an automatic certificate, which
# requires public DNS pointing here. For access on a local network only, use
# `:80` instead: Caddy then answers on any hostname over plain HTTP and requests
# no certificate. See docs/deployment.md.
DOMAIN=booking.example.com
# Email used for Let's Encrypt notifications. Not needed when DOMAIN is `:80`.
ACME_EMAIL=admin@example.com

# --- Container images ----------------------------------------------------
# Where compose.yml pulls the API and web images from. Both are private, so the
# server needs `docker login ghcr.io` with a token that has read:packages.
IMAGE_REGISTRY=ghcr.io/denislavmladenov
# Which build to run. Leave as latest to follow the newest push, or pin to the
# short commit tag that scripts/publish-images.sh prints, which is what makes a
# rollback possible.
IMAGE_TAG=latest

# --- Admin bootstrap ----------------------------------------------------
# Only read by the one-off `bootstrap:admin` command. Remove after the first
# admin account has been created.
ADMIN_EMAIL=barber@example.com
ADMIN_PASSWORD=
