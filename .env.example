# Every value here is optional.
#
# The production stack runs with no .env at all: `docker compose up -d` generates
# its own database password and session secret on first start, serves plain HTTP
# on port 80 for whatever address the host has, and derives the expected browser
# origin from each request. Copy this file only when you want to change something.
#
# The development servers (`pnpm dev`) do need DATABASE_URL and SESSION_SECRET,
# since they run outside the containers.

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
# error | warn | log | debug | verbose
LOG_LEVEL=log

# --- Database ------------------------------------------------------------
POSTGRES_USER=booking
POSTGRES_DB=booking
# Leave empty in the container stack and one is generated and kept in a volume.
# Required for local development, where PostgreSQL runs from compose.dev.yml.
POSTGRES_PASSWORD=

# Used by the development servers and by the Prisma CLI. The container stack
# assembles its own from the generated password.
DATABASE_URL=postgresql://booking:CHANGE_ME@localhost:5433/booking?schema=public
# Separate database for the integration test suite, which truncates tables.
TEST_DATABASE_URL=postgresql://booking:CHANGE_ME@localhost:5433/booking_test?schema=public

# --- Application ---------------------------------------------------------
# IANA timezone the shop operates in. All opening hours are interpreted in it.
BUSINESS_TIMEZONE=Europe/Sofia
CURRENCY=BGN

# Only for a client served from a different origin than the API. Normally empty,
# because Caddy serves the app and the API together and the CSRF guard checks
# each request against the address it was actually sent to.
CORS_ORIGINS=

# --- Sessions ------------------------------------------------------------
# Signs the session cookie. Leave empty in the container stack and one is
# generated and kept in a volume. Required for local development.
#   openssl rand -base64 36
SESSION_SECRET=
SESSION_COOKIE_NAME=barber_session
SESSION_TTL_DAYS=7

# --- API docs ------------------------------------------------------------
# Serves Swagger UI at /api/docs. Keep off in production.
ENABLE_SWAGGER=true

# --- Reverse proxy -------------------------------------------------------
# Trust X-Forwarded-* headers. Compose sets this for the container stack, where
# Caddy is the only way in. They carry the client address used for rate limiting
# and the protocol that decides whether cookies are marked Secure.
TRUST_PROXY=false

# --- Caddy ---------------------------------------------------------------
# The address Caddy serves.
#   :80             any hostname over plain HTTP, no certificate. The default.
#   example.com     a real hostname, with automatic HTTPS. Needs public DNS
#                   pointing at this machine and ports 80 and 443 reachable.
DOMAIN=:80
# Where the certificate authority sends expiry warnings. Only used when DOMAIN is
# a real hostname.
ACME_EMAIL=admin@example.com
# Publish the web tier on different host ports, for example if something already
# uses 80.
HTTP_PORT=80
HTTPS_PORT=443

# --- Container images ----------------------------------------------------
# Where compose.yml pulls from, and which build to run. Pin IMAGE_TAG to a commit
# tag printed by scripts/publish-images.sh to make a rollback possible.
IMAGE_REGISTRY=ghcr.io/denislavmladenov
IMAGE_TAG=latest

# --- Admin bootstrap ----------------------------------------------------
# Only read by the one-off bootstrap command. Prefer passing them inline:
#   docker compose exec -e ADMIN_EMAIL=... -e ADMIN_PASSWORD=... api booking bootstrap-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
