{
  "name": "@booking/api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS REST API for the barber booking platform",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "node --watch --enable-source-maps -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:integration": "jest --config test/jest-integration.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "seed": "node -r @swc-node/register src/scripts/seed.ts",
    "bootstrap:admin": "node -r @swc-node/register src/scripts/bootstrap-admin.ts"
  },
  "prisma": {
    "seed": "node -r @swc-node/register src/scripts/seed.ts"
  },
  "dependencies": {
    "@booking/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.4",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3"
  }
}
