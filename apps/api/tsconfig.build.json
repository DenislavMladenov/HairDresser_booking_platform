{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "types": ["node"],
    // Generated Prisma sources are not authored by us; unused-symbol checks are
    // relaxed for the emit build so a client regeneration cannot break it.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts", "test/**/*"]
}
