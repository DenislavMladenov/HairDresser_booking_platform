# Caddy is the only container with published ports. It terminates TLS, serves the
# built SPA and forwards /api to the API container over the internal network.
#
# DOMAIN examples:
#   :80                  any hostname over plain HTTP, no certificate. The
#                        default, so an unconfigured stack works on any host.
#   example.com          automatic HTTPS via Let's Encrypt
#   http://localhost     plain HTTP on localhost only

{
	# A placeholder default keeps this directive syntactically valid when no
	# address is configured, which matters because an unconfigured stack serves
	# plain HTTP and never contacts a certificate authority at all. Set a real
	# ACME_EMAIL for a public deployment so the CA can warn about expiry.
	email {$ACME_EMAIL:admin@example.com}
	# Uncomment while testing certificate issuance to avoid rate limits:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$DOMAIN} {
	encode zstd gzip

	# Container health check target; not part of the application.
	handle /healthz {
		respond "ok" 200
	}

	handle /api/* {
		reverse_proxy api:3000 {
			# The API needs the real client address for rate limiting.
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		root * /srv

		# Client-side routing: unknown paths are served the app shell so that
		# /admin/today works on a hard refresh.
		try_files {path} /index.html
		file_server
	}

	header {
		# HSTS is only meaningful over HTTPS; harmless otherwise.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# The app loads no third-party code. 'unsafe-inline' is needed for
		# style attributes React sets on elements; scripts stay restricted.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# Immutable hashed assets can be cached hard; the shell must not be.
	@hashedAssets path /assets/*
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	@appShell path / /index.html
	header @appShell Cache-Control "no-cache"

	log {
		output stdout
		format console
	}
}
